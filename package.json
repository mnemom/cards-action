{
  "name": "@mnemom/cards-action",
  "version": "1.0.0",
  "private": true,
  "description": "Care-framed CI feedback for Mnemom alignment + protection manifests",
  "keywords": ["mnemom", "agents", "governance", "ci", "github-action"],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "ncc build src/main.ts -o dist --source-map --license licenses.txt --minify",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src __tests__",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "all": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "dependencies": {
    "@actions/core": "1.11.1",
    "@actions/github": "6.0.1",
    "js-yaml": "4.1.1"
  },
  "devDependencies": {
    "@types/js-yaml": "4.0.9",
    "@types/node": "22.10.5",
    "@typescript-eslint/eslint-plugin": "8.20.0",
    "@typescript-eslint/parser": "8.20.0",
    "@vercel/ncc": "0.38.3",
    "@vitest/coverage-v8": "2.1.9",
    "eslint": "9.18.0",
    "typescript": "5.7.3",
    "vitest": "2.1.9"
  },
  "pnpm": {
    "overrides": {
      "@eslint/plugin-kit@<0.3.4": "0.3.4",
      "esbuild@<0.25.0": "0.25.0",
      "undici@<6.24.0": "6.24.0",
      "vite@<6.4.2": "6.4.2"
    }
  },
  "packageManager": "pnpm@10.30.1"
}
